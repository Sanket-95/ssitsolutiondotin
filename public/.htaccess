# Apache config for shared hosting (BigRock / cPanel). Copied into dist/ by the build.

Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

# Pages are folders (/services/index.html). Serve them at /services, not /services/.
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS and the bare domain: http://, www. -> https://ssitsolution.in
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://ssitsolution.in%{REQUEST_URI} [L,R=301]

  # Drop trailing slashes on page folders: /services/ -> /services
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.+)/$ /$1 [L,R=301]

  # Serve /services from /services/index.html
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+)$ /$1/index.html [L]
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
  AddType image/webp .webp
</IfModule>

<IfModule mod_headers.c>
  # Hashed build assets never change: cache for a year.
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # HTML always revalidates so new deploys show up immediately.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
